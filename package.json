{
  "name": "ramiro-portfolio", "version": "1.0.0", "private": true, "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build", "start": "node server/index.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:integration",
    "check": "npm test && npm run build && npm run test:e2e"
  },
  "dependencies": { "express": "^5.1.0", "express-rate-limit": "^8.1.0", "helmet": "^8.1.0", "react": "^19.2.0", "react-dom": "^19.2.0" },
  "devDependencies": { "@playwright/test": "^1.56.1", "@vitejs/plugin-react": "^5.1.0", "concurrently": "^9.2.1", "supertest": "^7.1.4", "vite": "^7.2.2" }
}
